{
	"name": "obsidian-miller-columns",
	"version": "1.0.0",
	"description": "Convert nested markdown lists into interactive, horizontal column views for focused task management.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"deploy:vault": "npm run build && node scripts/deploy-vault.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest",
		"test:ui": "vitest --ui"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/mdast": "^4.0.4",
		"@types/node": "^25.6.2",
		"@vitest/ui": "^4.1.6",
		"esbuild": "0.28.2",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jsdom": "^26.0.0",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^4.1.6"
	},
	"dependencies": {
		"obsidian": "1.10.3"
	}
}
